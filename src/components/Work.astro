---
import { Icon } from 'astro-icon/components'
import type { Repo } from '@modules/fetchRepos'

interface Props {
    repos: Repo[]
}

const { repos } = Astro.props
---

<section class="py-16" id="work" data-aos="fade-up">
    <div class="max-w-6xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-8">
            <Icon name="lucide:code" class="w-4 h-4 text-accent/70" />
            <span class="font-sans text-sm uppercase tracking-widest text-text-muted/60">Projects</span>
            <div class="flex-1 h-px bg-white/10"></div>
        </div>

        {repos.length > 0 ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {repos.map((repo) => (
                    <a
                        href={repo.url}
                        target="_blank"
                        class="group relative rounded-lg border border-white/10 p-6 overflow-hidden bg-linear-to-br from-transparent via-transparent to-transparent hover:from-accent/10 hover:via-accent-pink/5 hover:to-accent-cyan/5 hover:border-accent/30 hover:-translate-y-1 transition-all duration-300"
                    >
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <Icon name="lucide:code" class="w-4 h-4 shrink-0 text-text-muted/40 group-hover:text-accent transition-colors" />
                                <h3 class="font-sans text-lg font-bold text-text/90 group-hover:text-accent transition-colors truncate">
                                    {repo.name}
                                </h3>
                            </div>
                            {repo.stars > 0 && (
                                <span class="shrink-0 font-sans text-sm text-text-muted/40 tabular-nums flex items-center gap-1">
                                    <Icon name="lucide:star" class="w-3 h-3" fill="currentColor" />
                                    {repo.stars}
                                </span>
                            )}
                        </div>
                        {repo.description && (
                            <p class="font-serif text-base text-text-muted/60 mt-2 leading-relaxed line-clamp-2">
                                {repo.description}
                            </p>
                        )}
                        {repo.language && (
                            <div class="flex items-center gap-1.5 mt-3.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-accent/50"></span>
                                <span class="font-sans text-xs text-text-muted/40">{repo.language}</span>
                            </div>
                        )}
                    </a>
                ))}
            </div>
        ) : (
            <div class="rounded-lg bg-white/2 border border-white/10 p-10 text-center">
                <p class="font-serif text-base italic text-text-muted/60">Projects temporarily unavailable.</p>
                <a class="inline-block mt-4 font-sans text-sm text-accent hover:text-accent-pink transition-colors" href="https://github.com/notgabry">
                    Visit GitHub &rarr;
                </a>
            </div>
        )}

        <div class="mt-6 text-center">
            <a
                class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-white/5 border border-white/10 text-sm font-medium text-text-muted hover:text-white hover:bg-white/10 hover:border-white/20 hover:scale-105 transition-all"
                href="https://github.com/notgabry"
            >
                View all on GitHub &rarr;
            </a>
        </div>
    </div>
</section>
