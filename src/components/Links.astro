---
import { Icon } from 'astro-icon/components'

const links: { name: string; url: string }[] = [
    { name: 'GitHub', url: 'https://github.com/notgabry' },
    { name: 'Chess', url: 'https://chess.com/member/missing-her-eyes' },
    { name: 'Email', url: 'mailto:notg@ik.me' }
]
---

<div class="flex flex-wrap gap-3 justify-center">
    {links.map(({ name, url }) => (
        <a
            class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-white/5 border border-white/10 text-sm font-medium text-text-muted hover:text-white hover:bg-white/10 hover:border-white/20 transition-all"
            href={url}
        >
            <Icon name="lucide:external-link" class="w-3.5 h-3.5" />
            {name}
        </a>
    ))}
</div>
