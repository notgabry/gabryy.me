---
import '@fontsource/archivo-black'
import '@fontsource/public-sans/400.css'
import '@fontsource/public-sans/500.css'
import '@fontsource/public-sans/600.css'
import '@fontsource/public-sans/700.css'
import '@fontsource/playfair-display/400.css'
import '@fontsource/playfair-display/600.css'
import '@fontsource/playfair-display/700.css'
import 'aos/dist/aos.css'
import '../styles/global.css'
import AOSInit from '@components/AOSInit.svelte'
import SmoothScroll from '@components/SmoothScroll.svelte'

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content="Gabry's corner" />
        <title>{title} | notgabry</title>

        <meta property="og:title" content="notgabry" />
        <meta property="og:site_name" content="notgabry" />
        <meta property="og:description" content="Gabry's corner" />
        <meta property="theme-color" content="#8B5CF6" />

        <link rel="icon" href="/gabry-icon.png" />
        <link rel="shortcut icon" href="/gabry-icon.png" />
    </head>
    <body class="bg-bg text-text font-sans antialiased">
        <slot />
        <AOSInit client:load />
        <SmoothScroll client:load />
    </body>
</html>
