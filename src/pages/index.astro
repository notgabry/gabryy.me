---
import Layout from '@layouts/Layout.astro'
import Hero from '@components/Hero.astro'
import About from '@components/About.astro'
import Work from '@components/Work.astro'
import Live from '@components/Live.astro'
import Contact from '@components/Contact.astro'
import { fetchRepos } from '@modules/fetchRepos'

const repos = await fetchRepos()
---

<Layout title="Home">
    <nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 bg-bg/80 backdrop-blur-xl">
        <div class="flex items-center justify-between max-w-6xl mx-auto px-6 py-3.5">
            <span class="font-sans text-base font-bold tracking-tight text-text/90">notgabry</span>
            <div class="flex items-center gap-8">
                <a class="font-sans text-sm text-text-muted/60 hover:text-text transition-colors" href="#about">About</a>
                <a class="font-sans text-sm text-text-muted/60 hover:text-text transition-colors" href="#work">Work</a>
                <a class="font-sans text-sm text-text-muted/60 hover:text-text transition-colors" href="#live">Live</a>
                <a class="font-sans text-sm font-semibold text-accent hover:text-accent-pink transition-colors" href="mailto:notg@ik.me">Contact</a>
            </div>
        </div>
    </nav>

    <main class="pt-16">
        <Hero />
        <About />
        <Work repos={repos} />
        <Live />
        <Contact />
    </main>

    <footer class="border-t border-white/5 py-5">
        <div class="max-w-6xl mx-auto px-6 flex items-center justify-between">
            <span class="font-sans text-sm text-text-muted/30">notgabry &copy; 2025</span>
            <a class="font-sans text-sm text-text-muted/50 hover:text-accent transition-colors" href="mailto:notg@ik.me">
                notg@ik.me
            </a>
        </div>
    </footer>
</Layout>
